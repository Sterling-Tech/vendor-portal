# Django Settings
DJANGO_SECRET_KEY=change-this-in-production-to-a-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration
DJANGO_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quickcash
CIS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cis
LEGACY_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/legacy

# Redis Configuration
DJANGO_REDIS_URL=redis://localhost:6379/1

# Email Configuration
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=your-email@gmail.com
DJANGO_EMAIL_HOST_PASSWORD=your-app-password
DJANGO_EMAIL_USE_TLS=True

# JWT Configuration
JWT_SECRET_KEY=change-this-jwt-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# Payment Gateway (if applicable)
PAYMENT_API_KEY=your-payment-api-key
PAYMENT_SECRET_KEY=your-payment-secret

# SMS Configuration (for 2FA)
SMS_API_KEY=your-sms-api-key
SMS_SENDER_ID=QuickCash

# Other API Keys
EXTERNAL_API_KEY=
ANALYTICS_KEY=

# Production Settings (set to False in production)
DEBUG=True
